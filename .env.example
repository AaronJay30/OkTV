# YouTube API Key for the OKtv application
# Get your key from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# Optional: additional keys for automatic rotation when the daily quota is hit.
# The /api/youtube/search route iterates these on quota-class errors.
# Recommended: distribute keys across multiple GCP projects so each has its
# own daily quota (see specs/01-rotational-api-key.md).
YOUTUBE_API_KEY_1=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=

# Auto-rotate through the pool when a key hits a quota-class error
# (rateLimitExceeded, quotaExceeded, etc.). When false, the route uses only
# YOUTUBE_API_KEY and surfaces the first quota error as 429 immediately.
# Accepted: true | false (default: true)
YOUTUBE_API_KEY_AUTO_ROTATE=true

# Maximum number of YOUTUBE_API_KEY_N slots the route will scan (1-100,
# default 20). Set this to however many keys you actually have so the route
# reads every configured key without you touching the code. Example: 8 today,
# 12 next week — just bump this number.
YOUTUBE_API_KEY_MAX_SLOTS=20

# ─── Admin dashboard (spec 04) ─────────────────────────────────────
# Generate the bcrypt hash for your admin password with:
#   node scripts/hash-password.cjs
# Paste the printed hash below. Cost 11 (~100ms/verify).
ADMIN_PASSWORD_HASH=

# Generate the session secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 32 random bytes, base64-encoded. Used to HMAC-sign session cookies.
ADMIN_SESSION_SECRET=

# The URL segment under which the admin area lives. Defaults to
# "console-0724" if unset. Pick a non-obvious value in production —
# this is a bot-noise layer, not security (spec §4.3).
ADMIN_PATH_SLICE=console-0724

# Firebase configuration for the OKtv application
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_DATABASE_URL=YOUR_FIREBASE_DATABASE_URL
# Firebase Realtime Database URL for the OKtv application
# Get your database URL from your Firebase project settings
# Example: https://your-project-id.firebaseio.com
# Replace with your actual Firebase Realtime Database URL       
